PORT=3000
NODE_ENV=development
DEV_MONGO_URI=mongodb://localhost:27017/huetrip

CLIENT_ORIGIN=http://localhost:5173

CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me
CLOUDINARY_UPLOAD_FOLDER=location-images

JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LOCATION_ASSET_TOKEN_SECRET=change_me

# Natural-language location search. "mock" runs without an API key.
AI_PROVIDER=mock
AI_FALLBACK_TO_MOCK=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=10000

# In-memory protection for the public location-search endpoints.
SEARCH_RATE_LIMIT_WINDOW_MS=60000
SEARCH_AI_RATE_LIMIT_MAX=10
SEARCH_EXECUTE_RATE_LIMIT_MAX=60
SEARCH_PLAN_CACHE_TTL_MS=900000
SEARCH_FALLBACK_CACHE_TTL_MS=60000
SEARCH_PLAN_CACHE_MAX_ENTRIES=500
